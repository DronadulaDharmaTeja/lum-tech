# =========================================================
# SEO SETTINGS
# =========================================================

@admin.route("/seo", methods=["GET", "POST"])
@permission_required("seo", "view")
def seo():

    if request.method == "POST":
        if not can_access(current_user, "seo", "edit"):
            abort(403)

        flash(
            "SEO settings form submitted. Connect your existing SEO model fields to save changes.",
            "info",
        )

        return redirect(url_for("admin.seo"))

    return module_page("SEO Settings", "Manage your website SEO settings.")


