# =========================================================

@admin.route("/users")
@user_management_required
def users():

    records = User.query.order_by(
        User.id.desc()
    ).all()

    return render_template(
        "users.html",
        users=records,
        departments=DEPARTMENTS,
        modules=ADMIN_DELEGABLE_MODULES,
        actions=ACTIONS,
    )


@admin.route("/users/create", methods=["GET", "POST"])
@user_management_required
def create_user():

    if request.method == "POST":

        username = request.form.get("username", "").strip()
        email = request.form.get("email", "").strip()
        password = request.form.get("password", "")
        role = request.form.get("role", "staff").strip()
        department = request.form.get("department", "").strip()
        job_title = request.form.get("job_title", "").strip()

        if not username or not email or not password:
            flash("Username, email and password are required.", "error")
            return redirect(url_for("admin.create_user"))

        if role not in ["super_admin", "admin", "staff"]:
            flash("Invalid user role.", "error")
            return redirect(url_for("admin.create_user"))

        if role == "super_admin":
            flash("Creating another Super Admin is not available here.", "error")
            return redirect(url_for("admin.create_user"))

        if User.query.filter_by(email=email).first():
            flash("Email address already exists.", "error")
            return redirect(url_for("admin.create_user"))

        if User.query.filter_by(username=username).first():
            flash("Username already exists.", "error")
            return redirect(url_for("admin.create_user"))

        if not valid_department_and_job(department, job_title):
            flash("Select a valid department and enter a job title.", "error")
            return redirect(url_for("admin.create_user"))

        if len(password) < 12:
            flash("Password must contain at least 12 characters.", "error")
            return redirect(url_for("admin.create_user"))

        user = User(
            username=username,
            email=email,
            role=role,
            department=department,
            job_title=job_title,
        )

        user.set_password(password)

        if role == "admin":
            user.permissions = read_permissions_from_form()
        else:
            user.permissions = {}

        db.session.add(user)
        db.session.commit()

        flash("User created successfully.", "success")
        return redirect(url_for("admin.users"))

    return render_template(
        "admin/create_user.html",
        departments=DEPARTMENTS,
        modules=ADMIN_DELEGABLE_MODULES,
        actions=ACTIONS,
    )


@admin.route("/users/<int:user_id>/edit", methods=["GET", "POST"])
@user_management_required
def edit_user(user_id):

    user = User.query.get_or_404(user_id)

    if user.id == current_user.id:
        flash("You cannot edit your own account here.", "error")
        return redirect(url_for("admin.users"))

    if request.method == "POST":

        user.username = request.form.get(
            "username", user.username
        ).strip()

        user.email = request.form.get(
            "email", user.email
        ).strip()

        department = request.form.get(
            "department", ""
        ).strip()

        job_title = request.form.get(
            "job_title", ""
        ).strip()

        role = request.form.get(
            "role", user.role
        ).strip()

        if role not in ["admin", "staff"]:
            flash("Invalid role.", "error")
            return redirect(url_for("admin.edit_user", user_id=user.id))

        if not valid_department_and_job(department, job_title):
            flash("Invalid department or job title.", "error")
            return redirect(url_for("admin.edit_user", user_id=user.id))

        user.role = role
        user.department = department
        user.job_title = job_title

        if role == "admin":
            user.permissions = read_permissions_from_form()
        else:
            user.permissions = {}

        new_password = request.form.get("password", "")

        if new_password:
            if len(new_password) < 12:
                flash("Password must contain at least 12 characters.", "error")
                return redirect(url_for("admin.edit_user", user_id=user.id))

            user.set_password(new_password)

        db.session.commit()

        flash("User updated successfully.", "success")
        return redirect(url_for("admin.users"))

    return render_template(
        "edit_user.html",
        user=user,
        departments=DEPARTMENTS,
        modules=ADMIN_DELEGABLE_MODULES,
        actions=ACTIONS,
    )


@admin.route("/users/<int:user_id>/toggle-status", methods=["POST"])
@user_management_required
def toggle_user_status(user_id):

    user = User.query.get_or_404(user_id)

    if user.id == current_user.id:
        flash("You cannot deactivate your own account.", "error")
        return redirect(url_for("admin.users"))

    if not hasattr(user, "is_active"):
        flash("This User model does not support account status changes.", "error")
        return redirect(url_for("admin.users"))

    user.is_active = not user.is_active
    db.session.commit()

    flash("User status updated.", "success")
    return redirect(url_for("admin.users"))




