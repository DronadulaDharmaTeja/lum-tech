
from functools import wraps

from flask import (
    Blueprint,
    abort,
    render_template,
    request,
    redirect,
    url_for,
    flash,
)

from flask_login import login_required, current_user

from .extensions import db
from .models import (
    User,
    Project,
    Service,
    Testimonial,
    Lead,
    Media,
    ContactMessage,
    SEOSetting,
)

admin = Blueprint("admin", __name__, url_prefix="/admin")


# =========================================================
# DEPARTMENTS AND PERMISSIONS
# =========================================================

DEPARTMENTS = [
    "Project Management",
    "Construction & Site Operations",
    "Engineering & Technical",
    "CCTV & Security Systems",
    "Electrical & Networking",
    "Sales & Business Development",
    "Client Relations",
    "Procurement & Inventory",
    "Finance & Accounts",
    "HR & Recruitment",
    "Marketing & SEO",
    "IT & Systems",
    "Quality & Safety",
    "Media & Content",
]

MODULES = [
    "dashboard",
    "projects",
    "services",
    "testimonials",
    "leads",
    "project_tracker",
    "media",
    "contacts",
    "seo",
    "backups",
    "users",
]

ACTIONS = ["view", "create", "edit", "delete"]

ADMIN_DELEGABLE_MODULES = [
    "dashboard",
    "projects",
    "services",
    "testimonials",
    "leads",
    "project_tracker",
    "media",
    "contacts",
    "seo",
]

ADMIN_DEFAULT_PERMISSIONS = {
    module: ["view"]
    for module in ADMIN_DELEGABLE_MODULES
}


# =========================================================
# PERMISSION FUNCTIONS
# =========================================================

def effective_permissions(user):
    if not user or not user.is_authenticated:
        return {}

    if getattr(user, "role", None) == "super_admin":
        return {
            module: ACTIONS.copy()
            for module in MODULES
        }

    permissions = getattr(user, "permissions", None)

    if not permissions:
        if getattr(user, "role", None) == "admin":
            return {
                module: actions.copy()
                for module, actions in ADMIN_DEFAULT_PERMISSIONS.items()
            }
        return {}

    if isinstance(permissions, str):
        import json
        try:
            permissions = json.loads(permissions)
        except (ValueError, TypeError):
            return {}

    return permissions if isinstance(permissions, dict) else {}


def can_access(user, module, action="view"):
    if not user or not user.is_authenticated:
        return False

    if getattr(user, "role", None) == "super_admin":
        return True

    permissions = effective_permissions(user)

    return action in permissions.get(module, [])


def permission_required(module, action="view"):
    def decorator(view_function):

        @wraps(view_function)
        @login_required
        def wrapped_view(*args, **kwargs):

            if not can_access(current_user, module, action):
                abort(403)

            return view_function(*args, **kwargs)

        return wrapped_view

    return decorator


def user_management_required(view_function):
    @wraps(view_function)
    @login_required
    def wrapped_view(*args, **kwargs):

        if getattr(current_user, "role", None) != "super_admin":
            abort(403)

        return view_function(*args, **kwargs)

    return wrapped_view


# =========================================================
# HELPER FUNCTIONS
# =========================================================

def module_page(title, description, template="module.html"):
    return render_template(
        template,
        title=title,
        description=description,
    )


def read_permissions_from_form():
    permissions = {}

    for module in ADMIN_DELEGABLE_MODULES:
        selected = request.form.getlist(module)

        valid_actions = [
            action for action in selected
            if action in ACTIONS
        ]

        if valid_actions:
            permissions[module] = valid_actions

    return permissions


def valid_department_and_job(department, job_title):
    return (
        department in DEPARTMENTS
        and isinstance(job_title, str)
        and len(job_title.strip()) > 0
    )


# =========================================================
# ADMIN DASHBOARD
# =========================================================

@admin.route("/")
@admin.route("/dashboard")
@permission_required("dashboard", "view")
def dashboard():

    stats = {
        "users": User.query.count(),
        "projects": Project.query.count(),
        "services": Service.query.count(),
        "testimonials": Testimonial.query.count(),
        "leads": Lead.query.count(),
        "media": Media.query.count(),
        "messages": ContactMessage.query.count(),
    }

    return render_template(
        "dashboard.html",
        stats=stats,
        users_count=stats["users"],
        projects_count=stats["projects"],
        services_count=stats["services"],
        testimonials_count=stats["testimonials"],
        leads_count=stats["leads"],
        media_count=stats["media"],
        messages_count=stats["messages"],
    )


